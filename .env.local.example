# Copy this file to .env.local and fill in your values

# Admin secret — protects the GET /api/waitlist endpoint
ADMIN_SECRET=change-this-to-a-long-random-string

# Email provider (Resend — recommended, https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Or Mailchimp
# MAILCHIMP_API_KEY=
# MAILCHIMP_LIST_ID=

# Or ConvertKit
# CONVERTKIT_API_KEY=
# CONVERTKIT_FORM_ID=
